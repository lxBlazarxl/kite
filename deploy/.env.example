# Copy to .env next to docker-compose.yml. Never commit the real .env.

# Token every agent must send. Use a long random string, for example:
#   openssl rand -hex 32
AGENT_TOKEN=change-me-to-a-long-random-string

# Optional dashboard password. Without it, anyone who can reach the hub sees
# the dashboard and the agent token in "Add machine".
#WEB_PASSWORD=

# Image version to run (default: latest).
#KITE_VERSION=v0.1.0
